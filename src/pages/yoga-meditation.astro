    ))}
  </ul>
</div>
<script>
  import { inView } from "motion";
  import { annotate } from "rough-notation";
  const e = document.querySelector("#knowledge-series-heading") as HTMLElement;
  inView("#knowledge-series-container", () => {
    setTimeout(() => {
